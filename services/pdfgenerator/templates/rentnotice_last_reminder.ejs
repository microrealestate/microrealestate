<!DOCTYPE html>
<html>
<%- include('partials/htmlhead.ejs') %>

	<body>
		<% tenant.rents.forEach(function(rent) { %>
			<div class="page">
				<%- include('partials/header.ejs') %>

					<%- include('partials/customeraddress.ejs') %>

						<%- include('partials/customerreference.ejs', { rent: rent }) %>

							<%- include('partials/placeanddate.ejs', {rent: rent}) %>

								<div class="title">
									<%=_.t('Rent notice')%>
								</div>

								<div class="limit">
									<%-_.t('The total amount of <strong>{{amount}}</strong> was expected to be paid on {{date}}.', {
										amount: _.formatNumber(rent.total.amountDue, 'currency' ), date:
										_.formatDate(rent.dueDate, 'LL' ) }) %>
								</div>

								<div class="items">
									<table>

										<%- include('partials/documentbody', { rent: rent }) %>

											<%- include('partials/rentnoticetotal', { rent: rent }) %>

									</table>

										<%- include('partials/paymentdetails', { rent: rent }) %>
								</div>

								<%- include('partials/paymentmodalities') %>

									<%- include('partials/footer') %>

										<div class="rubber-stamp red">
											<%=_.t('Last reminder')%><br>
												<%=_.t('Before eviction')%>
										</div>
			</div>
			<% }); %>
	</body>

</html>