<!DOCTYPE html>
<html>
<%- include('/partials/htmlhead.ejs') %>

	<body>
		<% tenant.rents.forEach(function(rent) { %>
			<div class="page receipt">
				<%- include('partials/header.ejs') %>

					<%- include('partials/customeraddress.ejs') %>

						<%- include('partials/placeanddate.ejs', {rent: rent}) %>

							<div class="title">
								<%=_.t('Receipt')%>
							</div>

							<%- include('partials/customerreference.ejs', { rent: rent }) %>

								<div class="items">
									<table>
										<%- include('partials/documentbody.ejs', { rent: rent }) %>

											<%- include('partials/receipttotal.ejs', { rent: rent }) %>
									</table>
								</div>
								<%- include('partials/footer.ejs') %>
			</div>
			<% }); %>
	</body>

</html>