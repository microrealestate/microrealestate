<!doctype html>
<html>
  {{> html/htmlhead}}
  <body>
    <div class="email-body">
      <div class="email-container">
        <div class="bar"></div>
        <div class="content">
          <div class="header">
            <div class="logo">{{landlord.name}}</div>
          </div>

          <p>{{> html/greetings}}</p>

          <p>
            {{t 'We have received a sign-in attempt to your tenant space.'}}
          </p>

          <p>
            {{t 'To complete the sign-in process, enter the 6-digit code in the original window:'}}
          </p>

          <p class="otp">{{otp}}</p>

          <p>
            {{t "If you haven't request this code, no further action required. It will expire in 5 minutes."}}
          </p>

          {{> html/signature}}
        </div>
      </div>
      {{> html/landlordcontact}}
    </div>
  </body>
</html>
