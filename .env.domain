# Update this file with your own values and rename it to .env
# Tokens and secrets must be changed in production.
# For a previous running application, the secrets and tokens must 
# be reported in this file.

# Image tag: 'latest' or a git commit sha
MRE_VERSION=latest

# Reverse proxy. Pick ONE of the two configurations below.
# After a change, run './install.sh update'.
# See documentation/OPERATIONS.md, "Using your own reverse proxy".

# --- Option 1 (default): bundled Caddy -----------------------------------
# Caddy serves ports 80/443 and gets HTTPS certificates from Let's Encrypt.
# The domain and HTTPS are set in the application (Settings > Web server).
# With ports other than 80/443, Let's Encrypt cannot reach Caddy, so HTTPS
# certificates are not issued. Plain HTTP keeps working.
# MRE_REVERSE_PROXY=bundled
# MRE_HTTP_PORT=80
# MRE_HTTPS_PORT=443

# --- Option 2: your own reverse proxy (Apache, nginx, Traefik...) ---------
# Caddy does not start. The gateway listens on MRE_GATEWAY_BIND:MRE_HTTP_PORT
# and your proxy forwards to it. MRE_URL is required: the public URL your
# proxy serves. The app takes its domain from it, and HTTPS from https://.
# MRE_REVERSE_PROXY=external
# MRE_URL=https://mre.example.com
# MRE_HTTP_PORT=8080
# MRE_GATEWAY_BIND=127.0.0.1

# Database
# MONGO_URL=mongodb://mongo/mredb

# Trust proxy setting for rate limiting / real client IP resolution.
# Default trusts any number of private-network hops (Docker, the bundled
# Caddy reverse proxy) automatically. Only needed if you add your own
# reverse proxy or CDN with a *public* address in front of this stack —
# see documentation/OPERATIONS.md.
# TRUST_PROXY=uniquelocal

# Secrets and token must be changed in production
# this command can generate a random string: `openssl rand -base64 12`
#
# /!\ The secrets and tokens have to be backed up otherwise you will not
# be able to log in to the application, to access data from third-parties
# or to decrypt data from the database.
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret
RESET_TOKEN_SECRET=reset_token_secret
CIPHER_IV_KEY=cypher_iv_key
CIPHER_KEY=cipher_key
REDIS_PASSWORD=redis_password

# Email
# Mail ports this stack will connect to, for the mail server configured in the
# organization settings. Defaults to 25, 465, 587, 2525. Set it only when a
# relay listens on another port.
# SMTP_ALLOWED_PORTS=25,465,587,2525
#
# An internal relay is supported: a container name, host.docker.internal, or a
# private LAN address all work. Loopback and link-local addresses are always
# refused. Inside a container `localhost` is the container itself, so use
# host.docker.internal to reach a relay running on the host.
