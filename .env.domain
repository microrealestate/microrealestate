# Update this file with your own values and rename it to .env
# Tokens and secrets must be changed in production.
# For a previous running application, the secrets and tokens must 
# be reported in this file.

# Image tag: 'latest' or a git commit sha
MRE_VERSION=latest

# Host-side ports for the reverse proxy. Caveat: with non-default ports,
# Let's Encrypt cannot reach Caddy on 80/443 from the internet, so automatic
# HTTPS for domains will not issue certificates. Plain HTTP keeps working.
# MRE_HTTP_PORT=80
# MRE_HTTPS_PORT=443

# Database
# MONGO_URL=mongodb://mongo/mredb

# Trust proxy setting for rate limiting / real client IP resolution.
# Default trusts any number of private-network hops (Docker, the bundled
# Caddy reverse proxy) automatically. Only needed if you add your own
# reverse proxy or CDN with a *public* address in front of this stack —
# see documentation/OPERATIONS.md.
# TRUST_PROXY=uniquelocal

# Secrets and token must be changed in production
# this command can generate a random string: `openssl rand -base64 12`
#
# /!\ The secrets and tokens have to be backed up otherwise you will not
# be able to log in to the application, to access data from third-parties
# or to decrypt data from the database.
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret
RESET_TOKEN_SECRET=reset_token_secret
CIPHER_IV_KEY=cypher_iv_key
CIPHER_KEY=cipher_key
REDIS_PASSWORD=redis_password
